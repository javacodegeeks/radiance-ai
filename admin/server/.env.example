PORT=4000

# Shared Mongo/Qdrant instances — same cluster ai/ and data/ already point at.
# No per-tenant database; isolation is via the tenantId field / tenant_id payload key.
MONGO_USER=
MONGO_PASSWORD=
MONGO_HOST=
MONGO_PORT=
MONGO_DB_NAME=

QDRANT_URL=

# Shared Postgres instance — same "cosmetic_rai" DB ai/ already reads from
# (ingredient/CosIng safety reference tables, seeded by data/pipeline).
# Read-only from admin/server — never written to here.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Embedding generation — same LiteLLM proxy ai/ and data/pipeline use.
EMBEDDING_MODEL=
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Clerk — staff identity (Organizations = tenants, org role = admin | pharmacist).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Local dev only — set to "true" to skip Clerk entirely (every request is
# treated as an authenticated staff member of DEV_TENANT_ID). Pair with
# admin/web's VITE_DEV_BYPASS_AUTH=true. NEVER set this in production.
DEV_BYPASS_AUTH=false
DEV_TENANT_ID=dev-tenant
DEV_USER_ID=dev-user
