# Copy to .env and fill in values. Only the key for your active provider is required.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── LiteLLM proxy (docker-compose up -d litellm) ──────────────────────────────
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-litellm-master
# Options: gemma-4-local | gemini-2.0-flash | groq-llama-3.3-70b | gpt-4o-mini | claude-3-5-haiku
LLM_MODEL=gemma-4-local

# ── Embeddings ────────────────────────────────────────────────────────────────
# nomic-embed-text=192 dims | text-embedding-3-small=1536 | gemini-embedding-2=768
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_MODEL_DIMENSIONS=192

# ── API keys (only fill in what you use) ──────────────────────────────────────
TAVILY_API_KEY=tvly-...
# GEMINI_API_KEY=AIza...
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cosmetic_rai
DB_USER=postgres
DB_PASSWORD=postgres

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=mongo
MONGO_PASSWORD=mongo
MONGO_DB_NAME=obf

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
