{
  "info": {
    "name": "Radiance AI",
    "_postman_id": "radiance-ai-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "sessionId",
      "value": "test-session-001"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "header": []
      }
    },
    {
      "name": "Turn 1 — Initial concern",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"I have dry skin and redness on my face\"\n}"
        }
      }
    },
    {
      "name": "Turn 2 — Country",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"India\"\n}"
        }
      }
    },
    {
      "name": "Turn 3 — Skin type",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"Dry\"\n}"
        }
      }
    },
    {
      "name": "Turn 4 — Allergies",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"None\"\n}"
        }
      }
    },
    {
      "name": "Turn 5 — Conditions",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"None\"\n}"
        }
      }
    },
    {
      "name": "Turn 6 — Triggers",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"It gets worse after washing my face and in cold weather\"\n}"
        }
      }
    },
    {
      "name": "Turn 7 — Allergies",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"I am allergic to fragrance and alcohol\"\n}"
        }
      }
    },
    {
      "name": "Turn 8 — Triggers (repeat)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"It gets worse after washing my face and in cold weather\"\n}"
        }
      }
    },
    {
      "name": "New Session (restart)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"test-session-002\",\n  \"message\": \"I have oily skin and acne\"\n}"
        }
      }
    }
  ]
}
