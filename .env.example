# =============================================================================
# Radiance AI — environment variables
#
# HOW TO USE
# ----------
# 1. Copy this file:   cp .env.example .env
# 2. Fill in the required values (marked REQUIRED).
# 3. Leave defaults unchanged unless you have a specific reason to override.
# 4. Never commit your .env file — it is in .gitignore.
#
# WHICH KEYS DO I NEED?
# ---------------------
# Minimum to run locally:
#   - One LLM provider key (OPENAI_API_KEY is the default)
#   - TAVILY_API_KEY  (for the Web Researcher agent)
#   - All other variables have safe defaults for local/Docker use
#
# =============================================================================


# =============================================================================
# LLM PROVIDER API KEYS
# Only the key for your active LLM_MODEL provider is required.
# The rest can be left blank if you are not using that provider.
# =============================================================================

# OpenAI  — required if LLM_MODEL is gpt-4o-mini or gpt-4o
OPENAI_API_KEY=sk-...

# Anthropic — required if LLM_MODEL is claude-3-5-haiku or claude-sonnet-4-5
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — required if LLM_MODEL is gemini-2.0-flash or gemini-2.5-pro
GEMINI_API_KEY=AIza...

# xAI (Grok) — required if LLM_MODEL is grok-3 or grok-3-mini
XAI_API_KEY=xai-...

# Groq — required if LLM_MODEL is groq-llama-3.3-70b or groq-llama-3.1-8b
GROQ_API_KEY=gsk_...

# Tavily — REQUIRED for the Web Researcher agent (product web search)
# Get a free key at: https://app.tavily.com
TAVILY_API_KEY=tvly-...


# =============================================================================
# LiteLLM PROXY
# Acts as a unified gateway in front of all LLM providers.
# Runs as a Docker service on port 4000.
# The ai layer talks to this proxy — never directly to provider APIs.
# =============================================================================

# URL of the LiteLLM proxy.
#   Docker:     http://litellm:4000/v1   (service-to-service, Docker network)
#   Local dev:  http://localhost:4000/v1 (when running outside Docker)
LITELLM_BASE_URL=http://localhost:4000/v1

# Master key defined in docker/litellm-config.yaml → general_settings.master_key
# Change this if you update the config file.
LITELLM_API_KEY=sk-litellm-master

# Active LLM model for all agent calls.
# Must match a model_name entry in docker/litellm-config.yaml.
# Options:
#   OpenAI:     gpt-4o-mini (default, cheapest) | gpt-4o
#   Anthropic:  claude-3-5-haiku | claude-sonnet-4-5
#   Google:     gemini-2.0-flash | gemini-2.5-pro
#   xAI:        grok-3 | grok-3-mini
#   Groq:       groq-llama-3.3-70b | groq-llama-3.1-8b
LLM_MODEL=gpt-4o-mini


# =============================================================================
# EMBEDDINGS
# Used by the data layer to generate and store product vectors in Qdrant.
# Must also match a model_name entry in docker/litellm-config.yaml.
# =============================================================================

# Embedding model name.
# Options: text-embedding-3-small (OpenAI) | gemini-embedding-2 (Google)
EMBEDDING_MODEL=text-embedding-3-small

# Output dimensions for the chosen embedding model.
# Must match the pgvector index dimension in data/migrations/.
#   text-embedding-3-small → 1536
#   gemini-embedding-2     → 768
EMBEDDING_MODEL_DIMENSIONS=1536


# =============================================================================
# PostgreSQL  (safety rules + session data)
# Default credentials match the postgres service in docker/docker-compose.yml.
# =============================================================================

# Docker: use service name "postgres" as host.
# Local:  use "localhost".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cosmetic_rai
DB_USER=postgres
DB_PASSWORD=postgres


# =============================================================================
# MongoDB  (product catalogue documents from Open Beauty Facts)
# Default credentials match the mongodb service in docker/docker-compose.yml.
# =============================================================================

# Docker: use service name "mongodb" as host.
# Local:  use "localhost".
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=mongo
MONGO_PASSWORD=mongo
MONGO_DB_NAME=obf


# =============================================================================
# Qdrant  (product vector store for semantic similarity search)
# =============================================================================

# Docker: use service name "qdrant" as host → http://qdrant:6333
# Local:  http://localhost:6333
QDRANT_URL=http://localhost:6333


# =============================================================================
# UI  (Next.js app — port 3000)
# =============================================================================

# AI backend mode.
#
#   DOCKER (default): leave empty.
#     The AI layer is compiled into the ui image at build time (Dockerfile.ui
#     Stage 1) and run() is called in-process inside the Next.js server.
#     No separate AI container exists — AI_BACKEND_URL is not needed.
#
#   LOCAL DEV (outside Docker): leave empty.
#     Run `cd ai && npm run build` first so the compiled dist/ is available,
#     then start the UI with `cd ui && npm run dev`.
#
#   FUTURE / EXTRACTED SERVICE: set to the AI service URL.
#     If the AI layer is ever moved to its own container or repo and exposed
#     as an HTTP service, point this variable at it.
#     Example: AI_BACKEND_URL=http://ai-service:3001  (Docker service name)
#              AI_BACKEND_URL=https://ai.yourapp.com  (deployed service)
AI_BACKEND_URL=
