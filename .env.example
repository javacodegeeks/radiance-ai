# =============================================================================
# LLM Provider API Keys
# Only the key for your chosen LLM_MODEL provider is required.
# =============================================================================
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
XAI_API_KEY=xai-...
GROQ_API_KEY=gsk_...

# Web search (required for the Web Researcher agent)
TAVILY_API_KEY=tvly-...

# =============================================================================
# LiteLLM Proxy (ai layer)
# =============================================================================
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-litellm-master

# Model name must match an entry in docker/litellm-config.yaml
# Options: gpt-4o-mini, gpt-4o, claude-3-5-haiku, claude-sonnet-4-5,
#          gemini-2.0-flash, gemini-2.5-pro, grok-3, grok-3-mini, 
#          groq-llama-3.3-70b, groq-llama-3.1-8b
LLM_MODEL=gpt-4o-mini

# Model name must match an entry in docker/litellm-config.yaml
# Options: text-embedding-3-small, gemini-embedding-2
EMBEDDING_MODEL=text-embedding-3-small

# Dimensions for the chosen embedding model
# Options: text-embedding-3-small = 1536, gemini-embedding-2 = 768
EMBEDDING_MODEL_DIMENSIONS=1536

# =============================================================================
# PostgreSQL (data layer)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cosmetic_rai
DB_USER=postgres
DB_PASSWORD=postgres

# =============================================================================
# MongoDB (data layer)
# =============================================================================
DB_HOST=localhost
DB_PORT=27017
DB_NAME=obf
DB_USER=mongo
DB_PASSWORD=mongo
