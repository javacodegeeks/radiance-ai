# ─────────────────────────────────────────────────────────────────────────────
# Radiance AI — UI service
#
# Multi-stage build:
#   1. ai-builder   — compiles the AI layer to dist/
#   2. ui-builder   — installs UI deps (including ai as file dep), builds Next.js
#   3. runner       — lean production image
#
# Build context must be the repo root (set in docker-compose).
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Build AI layer ───────────────────────────────────────────────────
FROM node:20-alpine AS ai-builder

# python3/make/g++ are needed by some native deps (e.g. node-gyp)
RUN apk add --no-cache python3 make g++

WORKDIR /repo/data
COPY data/package*.json ./
RUN npm install --legacy-peer-deps

WORKDIR /repo/ai
COPY ai/package*.json ./
RUN npm install --legacy-peer-deps
# Copy both layers so tsc can resolve relative imports from ai/ into data/src/
COPY data/ /repo/data/
COPY ai/ .
# Increase heap for tsc — LangGraph types are large and hit the default limit
RUN NODE_OPTIONS=--max-old-space-size=4096 npm run build
# dist/ now exists at /repo/ai/dist/

# ── Stage 2: Build UI layer ───────────────────────────────────────────────────
FROM node:20-alpine AS ui-builder

RUN apk add --no-cache python3 make g++

# Copy the compiled AI layer so file:../ai resolves during npm install
COPY --from=ai-builder /repo/ai /repo/ai

WORKDIR /repo/ui
COPY ui/package*.json ./

# --install-links forces npm to copy (not symlink) the file: dependency.
# Without this, node_modules/radiance-ai-core is a symlink to /repo/ai which
# breaks in the production stage where /repo/ai does not exist.
RUN npm install --legacy-peer-deps --install-links

COPY ui/ .

ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ── Stage 3: Production runner ────────────────────────────────────────────────
FROM node:20-alpine AS runner

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs

WORKDIR /repo/ui

# Static assets
COPY --from=ui-builder /repo/ui/public ./public

# Next.js build output (standalone or default)
COPY --from=ui-builder --chown=nextjs:nodejs /repo/ui/.next ./.next

# Runtime dependencies and config
COPY --from=ui-builder /repo/ui/package*.json ./
COPY --from=ui-builder /repo/ui/next.config.js ./
COPY --from=ui-builder /repo/ui/node_modules ./node_modules

USER nextjs

EXPOSE 3000

CMD ["node_modules/.bin/next", "start"]
