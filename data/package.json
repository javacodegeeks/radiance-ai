{
  "name": "cosmetic-rai-data-layer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "pipeline": "ts-node -r dotenv/config pipeline/run-all.ts",
    "pipeline:migrate": "ts-node -r dotenv/config pipeline/01-migrate.ts",
    "pipeline:safety": "ts-node -r dotenv/config pipeline/02-seed-safety.ts",
    "pipeline:load": "ts-node -r dotenv/config pipeline/03-load-off.ts && ts-node -r dotenv/config pipeline/04-load-obf.ts",
    "pipeline:vectorize": "ts-node -r dotenv/config pipeline/05-vectorize.ts",
    "pipeline:cosing": "ts-node -r dotenv/config pipeline/06-load-cosing-restrictions.ts"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.16.2",
    "csv-parse": "^7.0.1",
    "mongodb": "^7.2.0",
    "pg": "^8.11.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "dotenv": "^16.0.0",
    "eslint": "^8.57.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
