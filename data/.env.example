# Copy to .env and fill in values before running the pipeline.

# ── LiteLLM proxy (needed for embedding generation in step 4) ─────────────────
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-litellm-master

# Embedding model — must match a model_name in docker/litellm-config.yaml
# nomic-embed-text=192 dims | text-embedding-3-small=1536 | gemini-embedding-2=768
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_MODEL_DIMENSIONS=192

# ── PostgreSQL (steps 1 + 2) ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cosmetic_rai
DB_USER=postgres
DB_PASSWORD=postgres

# ── MongoDB (steps 3 + 4) ─────────────────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=mongo
MONGO_PASSWORD=mongo
MONGO_DB_NAME=obf

# ── Qdrant (step 4) ───────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
